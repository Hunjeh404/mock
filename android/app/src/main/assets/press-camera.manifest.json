{
  "schemaVersion": 1,
  "product": {
    "name": "보도사진 카메라",
    "applicationId": "com.hoonjay.presscamera",
    "version": "1.1.1"
  },
  "camera": {
    "defaultMode": "자동",
    "modes": [
      "자동",
      "프로"
    ],
    "ratio": 1.5,
    "savePolicy": "RAW+JPG",
    "jpegQuality": 100,
    "editingEnabled": false,
    "presetManagementEnabled": false,
    "orientation": "landscape",
    "menuOrientation": "portrait",
    "requiresLandscapeHold": true
  },
  "content": {
    "catalog": "press-guides/catalog.json",
    "layouts": "press-guides/layouts/index.json",
    "preset": "press-guides/press-clean.json"
  },
  "maintenance": {
    "instructions": "AGENTS.md",
    "contentGuide": "docs/CONTENT_GUIDE.md",
    "architecture": "docs/ARCHITECTURE.md",
    "handoff": "docs/AI_HANDOFF.md"
  },
  "warnings": {
    "highlights": "밝은 곳이 제대로 촬영되지 않을 수 있어요.",
    "shadows": "어두운 곳이 제대로 촬영되지 않을 수 있어요."
  },
  "guideAppearance": {
    "defaultOpacity": 80,
    "opacityRange": [
      0,
      100
    ],
    "colors": [
      "테마색",
      "흰색",
      "검은색",
      "빨간색",
      "파란색",
      "노란색",
      "초록색"
    ],
    "opacityGesture": "horizontal-drag"
  }
}
